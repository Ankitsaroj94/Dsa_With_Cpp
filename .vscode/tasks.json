{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build and run active C++ file",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "g++ -I.. '${file}' -o '${fileDirname}/${fileBasenameNoExtension}' && '${fileDirname}/${fileBasenameNoExtension}'"
            ],
            "options": {
                "cwd": "${workspaceFolder}/C++"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true, // Focus the terminal after running the task
                "panel": "shared"
            }
        }
    ]
}